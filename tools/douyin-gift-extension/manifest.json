{
  "manifest_version": 3,
  "name": "BiliPDJ-GO 抖音礼物监听桥接",
  "version": "0.1.0",
  "description": "仅在已登录的抖音直播网页旁路读取礼物 WSS 消息，并转发到本机 BiliPDJ-GO。",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://live.douyin.com/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://live.douyin.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
